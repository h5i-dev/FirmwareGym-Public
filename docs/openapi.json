{
  "components": {
    "schemas": {
      "Evaluation": {
        "properties": {
          "budgets": {
            "properties": {
              "limits": {
                "additionalProperties": {
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "object"
              },
              "passed": {
                "type": "boolean"
              },
              "utilization": {
                "additionalProperties": {
                  "minimum": 0,
                  "type": "number"
                },
                "description": "Measured usage divided by the corresponding positive limit. Values can exceed 1. Missing measurements and zero limits have no ratio.",
                "type": "object"
              },
              "violations": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "compiled": {
            "type": "boolean"
          },
          "formal": {
            "$ref": "#/components/schemas/Section"
          },
          "fuzz": {
            "$ref": "#/components/schemas/Section"
          },
          "fuzz_run": {
            "properties": {
              "elapsed_ms": {
                "minimum": 0,
                "type": "integer"
              },
              "max_step_instructions": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "peak_stack_bytes": {
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "held_out": {
            "$ref": "#/components/schemas/Section"
          },
          "obligations": {
            "items": {
              "$ref": "#/components/schemas/ObligationResult"
            },
            "type": "array"
          },
          "provenance": {
            "description": "Task and source hashes, evaluation scope, and configured build and sandbox settings.",
            "type": "object"
          },
          "reward": {
            "type": "object"
          },
          "simulation": {
            "$ref": "#/components/schemas/Section"
          }
        },
        "required": [
          "compiled",
          "formal",
          "simulation",
          "budgets",
          "reward"
        ],
        "type": "object"
      },
      "EvaluationJob": {
        "properties": {
          "created_at": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "finished_at": {
            "type": "integer"
          },
          "job_id": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/Evaluation"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "canceling",
              "completed",
              "failed",
              "canceled"
            ],
            "type": "string"
          },
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "task_id",
          "status",
          "created_at"
        ],
        "type": "object"
      },
      "ObligationResult": {
        "properties": {
          "feedback": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "proved",
              "unproved",
              "not_checked"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "feedback"
        ],
        "type": "object"
      },
      "ProofModule": {
        "description": "One Lean source file (maximum 256 KiB UTF-8). Prove each task obligation as FirmwareGymSubmission.<id>; helpers can share the file.",
        "maxLength": 262144,
        "minLength": 1,
        "type": "string"
      },
      "Section": {
        "properties": {
          "feedback": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "passed": {
            "minimum": 0,
            "type": "integer"
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "passed",
          "total",
          "feedback"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      },
      "BearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Verified & resource-efficient embedded firmware benchmark API. Submitted proofs use public contracts. Public evaluation uses the public scenarios. Final evaluation is operator-only.",
    "title": "FirmwareGym Evaluation API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Service is healthy (`ok: true`, `status: \"healthy\"`)"
          }
        },
        "security": [],
        "summary": "Liveness & capacity check (unauthenticated for load balancers & OpenEnv)"
      }
    },
    "/mcp": {
      "post": {
        "responses": {
          "200": {
            "description": "JSON-RPC 2.0 response"
          }
        },
        "summary": "OpenEnv JSON-RPC 2.0 session & tool endpoint (`openenv/session/create`, `openenv/session/close`, `tools/list`, `tools/call`)"
      }
    },
    "/metadata": {
      "get": {
        "responses": {
          "200": {
            "description": "OpenEnv metadata"
          }
        },
        "security": [],
        "summary": "OpenEnv environment metadata (name, version, description)"
      }
    },
    "/schema": {
      "get": {
        "responses": {
          "200": {
            "description": "OpenEnv schema"
          }
        },
        "security": [],
        "summary": "OpenEnv action, observation, and state JSON schemas"
      }
    },
    "/v1/admin/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Server telemetry"
          },
          "403": {
            "description": "Forbidden (admin role required)"
          }
        },
        "summary": "Admin operational telemetry (requires admin role)"
      }
    },
    "/v1/jobs": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EvaluationJob"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Jobs ordered by most recent first"
          }
        },
        "summary": "List jobs owned by the caller"
      },
      "post": {
        "parameters": [
          {
            "description": "Replays the same request for this tenant while the job is retained",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "files": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "proof": {
                    "$ref": "#/components/schemas/ProofModule"
                  },
                  "task_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "task_id",
                  "files"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationJob"
                }
              }
            },
            "description": "Job accepted and queued"
          },
          "400": {
            "description": "Invalid submission (does not consume quota)"
          },
          "404": {
            "description": "Unknown task"
          },
          "409": {
            "description": "Idempotency key already used with a different request"
          },
          "429": {
            "description": "Rate limit, per-tenant concurrency cap, or monthly quota exceeded"
          },
          "503": {
            "description": "Global evaluation queue is full (`Retry-After` header set)"
          }
        },
        "summary": "Submit an asynchronous evaluation job (recommended for Renode / Lean 4 proofs)"
      }
    },
    "/v1/jobs/{job_id}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationJob"
                }
              }
            },
            "description": "Canceled, or canceling while subprocess cleanup is in progress"
          },
          "404": {
            "description": "Unknown job"
          },
          "409": {
            "description": "Job has already finished"
          },
          "503": {
            "description": "Could not persist cancellation"
          }
        },
        "summary": "Cancel a queued or running job owned by the caller"
      },
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationJob"
                }
              }
            },
            "description": "Job status and optional evaluation with obligation verdicts"
          },
          "404": {
            "description": "Unknown job"
          }
        },
        "summary": "Poll status and result of an async evaluation job owned by the caller"
      }
    },
    "/v1/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Authenticated identity and `usage` snapshot (`active_jobs`, `max_concurrent_jobs`, `monthly_used`, `monthly_quota`, `monthly_remaining`, `month`)"
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        },
        "summary": "Return caller API key identity, role, rate-limit quota, active concurrency, and UTC monthly usage"
      }
    },
    "/v1/tasks": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "family",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "level",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task catalog summary"
          }
        },
        "summary": "List tasks (supports optional ?family= and ?level= filters)"
      }
    },
    "/v1/tasks/{id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task detail"
          },
          "404": {
            "description": "Unknown task"
          }
        },
        "summary": "Fetch task README, starter Rust crate, public Lean 4 spec, fixed obligation declarations, budgets, optimization metrics, and public simulation scenario"
      }
    },
    "/v1/tasks/{id}/evaluate": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "files": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "proof": {
                    "$ref": "#/components/schemas/ProofModule"
                  }
                },
                "required": [
                  "files"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evaluation"
                }
              }
            },
            "description": "Public evaluation and per-obligation verdicts when Lean was submitted"
          },
          "400": {
            "description": "Rejected submission (invalid paths, size, `unsafe`/`extern`, or forbidden macros; does not consume quota)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limit, per-tenant concurrency cap, or monthly quota exceeded"
          },
          "503": {
            "description": "Global evaluation queue is full (`Retry-After` header set)"
          }
        },
        "summary": "Synchronously evaluate Rust and an optional Lean proof module against public specs"
      }
    },
    "/ws": {
      "get": {
        "responses": {
          "101": {
            "description": "WebSocket upgraded"
          }
        },
        "summary": "OpenEnv WebSocket RL episode endpoint (`reset`, `step`, `state`, `close`; supports structured `files`/`code` and TextArenaEnv `message` actions)"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    },
    {
      "ApiKeyAuth": []
    }
  ]
}
